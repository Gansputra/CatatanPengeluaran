<div class="space-y-8">
    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-3xl font-medium text-slate-800">Budgeting & Limits</h1>
            <p class="text-slate-500">Track and control your monthly spending</p>
        </div>
        <div class="flex gap-4">
            <button onclick="document.getElementById('budgetModal').classList.remove('hidden')"
                class="bg-indigo-600 text-white px-5 py-2.5 rounded-2xl font-medium hover:bg-indigo-700 transition-all shadow-lg shadow-indigo-100 flex items-center gap-2">
                <i data-lucide="plus-circle" class="w-5 h-5"></i>
                Set Limit
            </button>
            <div class="glass px-4 py-2 rounded-xl text-sm font-medium text-indigo-600 flex items-center gap-2">
                <i data-lucide="calendar" class="w-4 h-4"></i>
                <%= new Date().toLocaleDateString('id-ID', { month: 'long' , year: 'numeric' }) %>
            </div>
        </div>
    </div>

    <!-- Budget Setup Modal (Hidden by default) -->
    <div id="budgetModal"
        class="fixed inset-0 bg-slate-900/40 backdrop-blur-sm z-50 flex items-center justify-center hidden p-4">
        <div class="glass max-w-md w-full p-8 rounded-[2.5rem] shadow-2xl animate-in zoom-in duration-300">
            <div class="flex justify-between items-center mb-8">
                <h3 class="text-2xl font-medium text-slate-800">Set Monthly Limit</h3>
                <button onclick="document.getElementById('budgetModal').classList.add('hidden')"
                    class="p-2 hover:bg-slate-100 rounded-full transition-colors">
                    <i data-lucide="x" class="w-6 h-6 text-slate-400"></i>
                </button>
            </div>

            <form action="/analytics/budget" method="POST" class="space-y-6">
                <div class="form-group">
                    <label class="form-label">Category</label>
                    <div class="relative">
                        <input type="hidden" name="category_id" id="budgetCategoryId" required>
                        <div id="budgetCategoryTrigger"
                            class="form-input flex items-center justify-between cursor-pointer pr-12 group/trigger hover:ring-indigo-300">
                            <div class="flex items-center gap-3" id="budgetSelectedDisplay">
                                <i data-lucide="tag" class="w-5 h-5 text-slate-300"></i>
                                <span class="text-slate-400">Select category...</span>
                            </div>
                            <i data-lucide="chevron-down"
                                class="absolute right-6 top-1/2 -translate-y-1/2 w-5 h-5 text-slate-400 pointer-events-none transition-transform group-[.active]/trigger:-rotate-180"></i>
                        </div>

                        <!-- Dropdown Content -->
                        <div id="budgetCategoryDropdown"
                            class="absolute top-full left-0 w-full mt-2 bg-white rounded-3xl shadow-2xl border border-slate-100 p-2 z-[60] hidden animate-in slide-in-from-top-2 duration-200">
                            <div class="max-h-[240px] overflow-y-auto custom-scrollbar space-y-1">
                                <% categories.forEach(cat=> { %>
                                    <div class="budget-category-option flex items-center gap-4 p-4 rounded-2xl hover:bg-slate-50 cursor-pointer transition-all active:scale-[0.98]"
                                        data-id="<%= cat.id %>" data-name="<%= cat.name %>" data-icon="<%= cat.icon %>"
                                        data-color="<%= cat.color %>">
                                        <div class="w-10 h-10 rounded-xl flex items-center justify-center text-white"
                                            style="background-color: <%= cat.color %>">
                                            <i data-lucide="<%= cat.icon %>" class="w-5 h-5"></i>
                                        </div>
                                        <span class="font-medium text-slate-700">
                                            <%= cat.name %>
                                        </span>
                                    </div>
                                    <% }) %>
                            </div>
                        </div>

                        <script>
                            document.addEventListener('DOMContentLoaded', () => {
                                const trigger = document.getElementById('budgetCategoryTrigger');
                                const dropdown = document.getElementById('budgetCategoryDropdown');
                                const selectedDisplay = document.getElementById('budgetSelectedDisplay');
                                const hiddenInput = document.getElementById('budgetCategoryId');
                                const options = document.querySelectorAll('.budget-category-option');

                                trigger.addEventListener('click', () => {
                                    dropdown.classList.toggle('hidden');
                                    trigger.classList.toggle('active');
                                    trigger.classList.toggle('ring-indigo-500');
                                });

                                options.forEach(option => {
                                    option.addEventListener('click', () => {
                                        const { id, name, icon, color } = option.dataset;
                                        selectedDisplay.innerHTML = `
                                            <div class="w-8 h-8 rounded-lg flex items-center justify-center animate-in zoom-in text-white" style="background-color: ${color}">
                                                <i data-lucide="${icon}" class="w-4 h-4"></i>
                                            </div>
                                            <span class="text-slate-800 font-medium">${name}</span>
                                        `;
                                        hiddenInput.value = id;
                                        dropdown.classList.add('hidden');
                                        trigger.classList.remove('active');
                                        trigger.classList.remove('ring-indigo-500');
                                        if (window.lucide) lucide.createIcons();
                                    });
                                });

                                document.addEventListener('click', (e) => {
                                    if (!trigger.contains(e.target) && !dropdown.contains(e.target)) {
                                        dropdown.classList.add('hidden');
                                        trigger.classList.remove('active');
                                        trigger.classList.remove('ring-indigo-500');
                                    }
                                });
                            });
                        </script>
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-label">Amount Limit</label>
                    <div class="relative group">
                        <span
                            class="absolute left-6 top-1/2 -translate-y-1/2 font-medium text-slate-400 transition-colors group-focus-within:text-indigo-600">Rp</span>
                        <input type="number" name="amount_limit" required placeholder="0"
                            class="form-input pl-14 text-2xl h-16">
                    </div>
                </div>

                <button type="submit" class="btn-primary w-full py-5 text-lg mt-4">
                    <i data-lucide="save" class="w-5 h-5"></i>
                    Save Budget Limit
                </button>
            </form>
        </div>
    </div>

    <% if (budgetData.length===0) { %>
        <div class="glass p-16 rounded-[2.5rem] text-center space-y-6">
            <div class="w-24 h-24 bg-slate-50 rounded-full flex items-center justify-center mx-auto shadow-inner">
                <i data-lucide="shield-alert" class="w-12 h-12 text-slate-300"></i>
            </div>
            <div class="space-y-2">
                <h3 class="text-2xl font-medium text-slate-800">No Budgets Set</h3>
                <p class="text-slate-500 max-w-xs mx-auto">You haven't set any spending limits yet. Let's start
                    tracking, King!</p>
            </div>
            <button onclick="document.getElementById('budgetModal').classList.remove('hidden')"
                class="btn-primary px-10 py-4 rounded-2xl mx-auto">
                <i data-lucide="plus" class="w-5 h-5"></i>
                Setup First Budget
            </button>
        </div>
        <% } else { %>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <% budgetData.forEach(budget=> {
                    const percentage = (budget.spent / budget.limit) * 100;
                    let barColor = 'bg-indigo-600';
                    let textColor = 'text-indigo-600';
                    let ringColor = 'ring-indigo-100';

                    if (percentage >= 100) {
                    barColor = 'bg-rose-500';
                    textColor = 'text-rose-600';
                    ringColor = 'ring-rose-100';
                    } else if (percentage >= 80) {
                    barColor = 'bg-amber-500';
                    textColor = 'text-amber-600';
                    ringColor = 'ring-amber-100';
                    }
                    %>
                    <div
                        class="glass p-6 rounded-3xl relative overflow-hidden group hover:ring-2 transition-all <%= ringColor %>">
                        <div class="flex items-center justify-between mb-6">
                            <div class="flex items-center gap-4">
                                <div class="w-12 h-12 rounded-2xl flex items-center justify-center"
                                    style="background-color: <%= budget.categoryColor %>15; color: <%= budget.categoryColor %>">
                                    <i data-lucide="<%= budget.categoryIcon %>" class="w-6 h-6"></i>
                                </div>
                                <div>
                                    <h4 class="font-medium text-slate-800 text-lg">
                                        <%= budget.categoryName %>
                                    </h4>
                                    <p class="text-xs text-slate-400 font-medium uppercase tracking-wider">Monthly Limit
                                    </p>
                                </div>
                            </div>
                            <div class="text-right">
                                <p class="text-lg font-medium text-slate-900">
                                    <%= (percentage>= 100) ? 'EXCEEDED' : formatter.formatCurrency(budget.limit -
                                        budget.spent) %>
                                </p>
                                <p class="text-[10px] text-slate-400 font-medium uppercase tracking-tighter">
                                    <%= (percentage>= 100) ? 'Over Budget' : 'Remaining' %>
                                </p>
                            </div>
                        </div>

                        <!-- Progress Section -->
                        <div class="space-y-3">
                            <div class="flex items-end justify-between text-sm font-medium">
                                <span class="<%= textColor %>">
                                    <%= Math.round(percentage) %>% Used
                                </span>
                                <span class="text-slate-400">
                                    <span class="text-slate-800">
                                        <%= formatter.formatCurrency(budget.spent) %>
                                    </span> / <%= formatter.formatCurrency(budget.limit) %>
                                </span>
                            </div>

                            <!-- Progress Bar Container -->
                            <div class="h-4 w-full bg-slate-100 rounded-full overflow-hidden p-1">
                                <div class="h-full rounded-full transition-all duration-1000 ease-out <%= barColor %>"
                                    style="width: <%= Math.min(percentage, 100) %>%">
                                    <!-- Subtle Shine Effect -->
                                    <div
                                        class="w-full h-full opacity-20 bg-gradient-to-r from-transparent via-white to-transparent">
                                    </div>
                                </div>
                            </div>

                            <% if (percentage>= 100) { %>
                                <div class="flex items-center gap-1.5 text-xs font-medium text-rose-500 mt-2">
                                    <i data-lucide="alert-circle" class="w-3.5 h-3.5"></i>
                                    Stop spending, King! Budget for this category is gone.
                                </div>
                                <% } else if (percentage>= 80) { %>
                                    <div class="flex items-center gap-1.5 text-xs font-medium text-amber-500 mt-2">
                                        <i data-lucide="zap" class="w-3.5 h-3.5"></i>
                                        Hati-hati King, hampir mencapai limit!
                                    </div>
                                    <% } %>
                        </div>
                    </div>
                    <% }) %>
            </div>
            <% } %>

                <!-- Quick Stats -->
                <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                    <div class="glass p-6 rounded-3xl border-l-4 border-indigo-500">
                        <h5 class="text-slate-500 text-xs font-medium uppercase tracking-widest mb-2">Total Budget</h5>
                        <p class="text-2xl font-medium text-slate-800">
                            <%= formatter.formatCurrency(budgetData.reduce((acc, b)=> acc + b.limit, 0)) %>
                        </p>
                    </div>
                    <div class="glass p-6 rounded-3xl border-l-4 border-rose-500">
                        <h5 class="text-slate-500 text-xs font-medium uppercase tracking-widest mb-2">Total Spent</h5>
                        <p class="text-2xl font-medium text-slate-800">
                            <%= formatter.formatCurrency(budgetData.reduce((acc, b)=> acc + b.spent, 0)) %>
                        </p>
                    </div>
                    <div class="glass p-6 rounded-3xl border-l-4 border-emerald-500">
                        <h5 class="text-slate-500 text-xs font-medium uppercase tracking-widest mb-2">Net Remaining</h5>
                        <p class="text-2xl font-medium text-slate-800">
                            <%= formatter.formatCurrency(budgetData.reduce((acc, b)=> acc + b.limit, 0) -
                                budgetData.reduce((acc, b) => acc + b.spent, 0)) %>
                        </p>
                    </div>
                </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        if (window.lucide) lucide.createIcons();
    });
</script>