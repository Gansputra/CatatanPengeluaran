<div class="space-y-8">
    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-3xl font-black text-slate-800">Budgeting & Limits</h1>
            <p class="text-slate-500">Track and control your monthly spending</p>
        </div>
        <div class="glass px-4 py-2 rounded-xl text-sm font-bold text-indigo-600 flex items-center gap-2">
            <i data-lucide="calendar" class="w-4 h-4"></i>
            <%= new Date().toLocaleDateString('id-ID', { month: 'long' , year: 'numeric' }) %>
        </div>
    </div>

    <% if (budgetData.length===0) { %>
        <div class="glass p-12 rounded-3xl text-center space-y-4">
            <div class="w-20 h-20 bg-slate-100 rounded-full flex items-center justify-center mx-auto">
                <i data-lucide="shield-alert" class="w-10 h-10 text-slate-400"></i>
            </div>
            <div>
                <h3 class="text-xl font-bold text-slate-800">No Budgets Set</h3>
                <p class="text-slate-500">You haven't set any spending limits yet, King!</p>
            </div>
            <button
                class="bg-indigo-600 text-white px-6 py-2.5 rounded-xl font-bold hover:bg-indigo-700 transition-all shadow-lg shadow-indigo-200">
                Setup First Budget
            </button>
        </div>
        <% } else { %>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <% budgetData.forEach(budget=> {
                    const percentage = (budget.spent / budget.limit) * 100;
                    let barColor = 'bg-indigo-600';
                    let textColor = 'text-indigo-600';
                    let ringColor = 'ring-indigo-100';

                    if (percentage >= 100) {
                    barColor = 'bg-rose-500';
                    textColor = 'text-rose-600';
                    ringColor = 'ring-rose-100';
                    } else if (percentage >= 80) {
                    barColor = 'bg-amber-500';
                    textColor = 'text-amber-600';
                    ringColor = 'ring-amber-100';
                    }
                    %>
                    <div
                        class="glass p-6 rounded-3xl relative overflow-hidden group hover:ring-2 transition-all <%= ringColor %>">
                        <div class="flex items-center justify-between mb-6">
                            <div class="flex items-center gap-4">
                                <div class="w-12 h-12 rounded-2xl flex items-center justify-center"
                                    style="background-color: <%= budget.categoryColor %>15; color: <%= budget.categoryColor %>">
                                    <i data-lucide="<%= budget.categoryIcon %>" class="w-6 h-6"></i>
                                </div>
                                <div>
                                    <h4 class="font-bold text-slate-800 text-lg">
                                        <%= budget.categoryName %>
                                    </h4>
                                    <p class="text-xs text-slate-400 font-bold uppercase tracking-wider">Monthly Limit
                                    </p>
                                </div>
                            </div>
                            <div class="text-right">
                                <p class="text-lg font-black text-slate-900">
                                    <%= (percentage>= 100) ? 'EXCEEDED' : formatter.formatCurrency(budget.limit -
                                        budget.spent) %>
                                </p>
                                <p class="text-[10px] text-slate-400 font-black uppercase tracking-tighter">
                                    <%= (percentage>= 100) ? 'Over Budget' : 'Remaining' %>
                                </p>
                            </div>
                        </div>

                        <!-- Progress Section -->
                        <div class="space-y-3">
                            <div class="flex items-end justify-between text-sm font-bold">
                                <span class="<%= textColor %>">
                                    <%= Math.round(percentage) %>% Used
                                </span>
                                <span class="text-slate-400">
                                    <span class="text-slate-800">
                                        <%= formatter.formatCurrency(budget.spent) %>
                                    </span> / <%= formatter.formatCurrency(budget.limit) %>
                                </span>
                            </div>

                            <!-- Progress Bar Container -->
                            <div class="h-4 w-full bg-slate-100 rounded-full overflow-hidden p-1">
                                <div class="h-full rounded-full transition-all duration-1000 ease-out <%= barColor %>"
                                    style="width: <%= Math.min(percentage, 100) %>%">
                                    <!-- Subtle Shine Effect -->
                                    <div
                                        class="w-full h-full opacity-20 bg-gradient-to-r from-transparent via-white to-transparent">
                                    </div>
                                </div>
                            </div>

                            <% if (percentage>= 100) { %>
                                <div class="flex items-center gap-1.5 text-xs font-bold text-rose-500 mt-2">
                                    <i data-lucide="alert-circle" class="w-3.5 h-3.5"></i>
                                    Stop spending, King! Budget for this category is gone.
                                </div>
                                <% } else if (percentage>= 80) { %>
                                    <div class="flex items-center gap-1.5 text-xs font-bold text-amber-500 mt-2">
                                        <i data-lucide="zap" class="w-3.5 h-3.5"></i>
                                        Hati-hati King, hampir mencapai limit!
                                    </div>
                                    <% } %>
                        </div>
                    </div>
                    <% }) %>
            </div>
            <% } %>

                <!-- Quick Stats -->
                <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                    <div class="glass p-6 rounded-3xl border-l-4 border-indigo-500">
                        <h5 class="text-slate-500 text-xs font-black uppercase tracking-widest mb-2">Total Budget</h5>
                        <p class="text-2xl font-black text-slate-800">
                            <%= formatter.formatCurrency(budgetData.reduce((acc, b)=> acc + b.limit, 0)) %>
                        </p>
                    </div>
                    <div class="glass p-6 rounded-3xl border-l-4 border-rose-500">
                        <h5 class="text-slate-500 text-xs font-black uppercase tracking-widest mb-2">Total Spent</h5>
                        <p class="text-2xl font-black text-slate-800">
                            <%= formatter.formatCurrency(budgetData.reduce((acc, b)=> acc + b.spent, 0)) %>
                        </p>
                    </div>
                    <div class="glass p-6 rounded-3xl border-l-4 border-emerald-500">
                        <h5 class="text-slate-500 text-xs font-black uppercase tracking-widest mb-2">Net Remaining</h5>
                        <p class="text-2xl font-black text-slate-800">
                            <%= formatter.formatCurrency(budgetData.reduce((acc, b)=> acc + b.limit, 0) -
                                budgetData.reduce((acc, b) => acc + b.spent, 0)) %>
                        </p>
                    </div>
                </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        if (window.lucide) lucide.createIcons();
    });
</script>