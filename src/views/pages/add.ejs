<div class="max-w-xl mx-auto">
    <div class="glass p-8 rounded-3xl relative overflow-hidden">
        <!-- Header -->
        <div class="flex items-center gap-4 mb-8">
            <div
                class="w-12 h-12 bg-indigo-600 rounded-2xl flex items-center justify-center shadow-lg shadow-indigo-200">
                <i data-lucide="plus-circle" class="w-6 h-6 text-white"></i>
            </div>
            <div>
                <h2 class="text-2xl font-medium text-slate-800">Add Transaction</h2>
                <p class="text-sm text-slate-400">Track your cashflow with ease</p>
            </div>
        </div>

        <form action="/add" method="POST" class="space-y-8">
            <!-- Type Switcher -->
            <div class="grid grid-cols-2 gap-4 p-1.5 bg-slate-100 rounded-[1.5rem]">
                <label class="cursor-pointer">
                    <input type="radio" name="type" value="expense" checked class="hidden peer">
                    <div
                        class="text-center py-3 rounded-2xl font-medium text-sm transition-all peer-checked:bg-white peer-checked:text-rose-600 peer-checked:shadow-sm text-slate-500 flex items-center justify-center gap-2">
                        <i data-lucide="arrow-down-circle" class="w-4 h-4"></i>
                        Expense
                    </div>
                </label>
                <label class="cursor-pointer">
                    <input type="radio" name="type" value="income" class="hidden peer">
                    <div
                        class="text-center py-3 rounded-2xl font-medium text-sm transition-all peer-checked:bg-white peer-checked:text-emerald-600 peer-checked:shadow-sm text-slate-500 flex items-center justify-center gap-2">
                        <i data-lucide="arrow-up-circle" class="w-4 h-4"></i>
                        Income
                    </div>
                </label>
            </div>

            <!-- Amount Input -->
            <div class="form-group">
                <label class="form-label">Amount (IDR)</label>
                <div class="relative group">
                    <span
                        class="absolute left-6 top-1/2 -translate-y-1/2 font-medium text-slate-400 text-xl transition-colors group-focus-within:text-indigo-600">Rp</span>
                    <input type="number" name="amount" required placeholder="0"
                        class="form-input pl-16 text-3xl h-20 shadow-sm">
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <!-- Category Select -->
                <div class="form-group">
                    <label class="form-label">Category</label>
                    <div class="relative">
                        <input type="hidden" name="category_id" id="selectedCategoryId" required>
                        <div id="categoryTrigger"
                            class="form-input flex items-center justify-between cursor-pointer pr-12 group/trigger hover:ring-indigo-300">
                            <div class="flex items-center gap-3" id="selectedDisplay">
                                <i data-lucide="tag" class="w-5 h-5 text-slate-300"></i>
                                <span class="text-slate-400">Select category...</span>
                            </div>
                            <i data-lucide="chevron-down"
                                class="absolute right-6 top-1/2 -translate-y-1/2 w-5 h-5 text-slate-400 pointer-events-none transition-transform group-[.active]/trigger:-rotate-180"></i>
                        </div>
                        <!-- Dropdown Content -->
                        <div id="categoryDropdown"
                            class="absolute top-full left-0 w-full mt-2 bg-white rounded-3xl shadow-2xl border border-slate-100 p-2 z-[60] hidden animate-in slide-in-from-top-2 duration-200">
                            <div class="max-h-[280px] overflow-y-auto custom-scrollbar space-y-1">
                                <% categories.forEach(cat=> { %>
                                    <div class="category-option flex items-center gap-4 p-4 rounded-2xl hover:bg-slate-50 cursor-pointer transition-all active:scale-[0.98]"
                                        data-id="<%= cat.id %>" data-name="<%= cat.name %>" data-icon="<%= cat.icon %>"
                                        data-color="<%= cat.color %>">
                                        <div class="w-10 h-10 rounded-xl flex items-center justify-center text-white"
                                            style="background-color: <%= cat.color %>">
                                            <i data-lucide="<%= cat.icon %>" class="w-5 h-5"></i>
                                        </div>
                                        <span class="font-medium text-slate-700">
                                            <%= cat.name %>
                                        </span>
                                    </div>
                                    <% }) %>
                            </div>
                        </div>

                        <script>
                            document.addEventListener('DOMContentLoaded', () => {
                                const trigger = document.getElementById('categoryTrigger');
                                const dropdown = document.getElementById('categoryDropdown');
                                const selectedDisplay = document.getElementById('selectedDisplay');
                                const hiddenInput = document.getElementById('selectedCategoryId');
                                const options = document.querySelectorAll('.category-option');

                                // Toggle Dropdown
                                trigger.addEventListener('click', (e) => {
                                    dropdown.classList.toggle('hidden');
                                    trigger.classList.toggle('active');
                                    trigger.classList.toggle('ring-indigo-500');
                                });

                                // Select Option
                                options.forEach(option => {
                                    option.addEventListener('click', () => {
                                        const id = option.dataset.id;
                                        const name = option.dataset.name;
                                        const icon = option.dataset.icon;
                                        const color = option.dataset.color;

                                        // Update Visuals
                                        selectedDisplay.innerHTML = `
                                            <div class="w-8 h-8 rounded-lg flex items-center justify-center animate-in zoom-in text-white" style="background-color: ${color}">
                                                <i data-lucide="${icon}" class="w-4 h-4"></i>
                                            </div>
                                            <span class="text-slate-800 font-medium">${name}</span>
                                        `;

                                        // Update Value
                                        hiddenInput.value = id;

                                        // Close & Refresh Icons
                                        dropdown.classList.add('hidden');
                                        trigger.classList.remove('active');
                                        trigger.classList.remove('ring-indigo-500');
                                        if (window.lucide) lucide.createIcons();
                                    });
                                });

                                // Close on Outside Click
                                document.addEventListener('click', (e) => {
                                    if (!trigger.contains(e.target) && !dropdown.contains(e.target)) {
                                        dropdown.classList.add('hidden');
                                        trigger.classList.remove('active');
                                        trigger.classList.remove('ring-indigo-500');
                                    }
                                });
                            });
                        </script>
                    </div>
                </div>

                <!-- Date Input -->
                <div class="form-group">
                    <label class="form-label">Date</label>
                    <input type="date" name="date" value="<%= new Date().toISOString().split('T')[0] %>" required
                        class="form-input">
                </div>
            </div>

            <!-- Note Input -->
            <div class="form-group">
                <label class="form-label">Note / Description</label>
                <textarea name="note" placeholder="What was this for?" rows="3"
                    class="form-input resize-none py-4"></textarea>
            </div>

            <!-- Submit Button -->
            <button type="submit" class="btn-primary w-full py-6 text-xl mt-4">
                <i data-lucide="check-circle" class="w-6 h-6"></i>
                Save Transaction
            </button>
        </form>

        <a href="/"
            class="block text-center mt-8 text-sm font-medium text-slate-400 hover:text-indigo-600 transition-all hover:translate-x-1">
            <span class="inline-flex items-center gap-2">
                <i data-lucide="arrow-left" class="w-4 h-4"></i>
                Cancel and Go Back
            </span>
        </a>
    </div>
</div>