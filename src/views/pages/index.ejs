<div class="max-w-4xl mx-auto">
    <div class="bg-white p-6 rounded-xl shadow-md mb-6">
        <h2 class="text-gray-500 text-sm uppercase">Total Pengeluaran</h2>
        <p class="text-3xl font-bold text-red-500"><%= total %></p>
    </div>

    <div class="bg-white rounded-xl shadow-md overflow-hidden">
        <table class="w-full text-left">
            <thead class="bg-gray-50 border-b">
                <tr>
                    <th class="p-4">Tanggal</th>
                    <th class="p-4">Keterangan</th>
                    <th class="p-4">Kategori</th>
                    <th class="p-4 text-right">Jumlah</th>
                </tr>
            </thead>
            <tbody>
                <% expenses.forEach(item => { %>
                <tr class="border-b hover:bg-gray-50">
                    <td class="p-4 text-sm"><%= formatter.formatDate(item.created_at) %></td>
                    <td class="p-4 font-medium"><%= item.title %></td>
                    <td class="p-4"><span class="bg-blue-100 text-blue-700 px-2 py-1 rounded text-xs"><%= item.category %></span></td>
                    <td class="p-4 text-right font-bold"><%= formatter.formatCurrency(item.amount) %></td>
                </tr>
                <% }) %>
            </tbody>
        </table>
    </div>
</div>