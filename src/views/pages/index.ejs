<div class="space-y-8">
    <!-- Stats Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- Balance Card -->
        <div class="glass p-6 rounded-3xl relative overflow-hidden group">
            <div class="absolute top-0 right-0 p-4 opacity-10 group-hover:scale-110 transition-transform duration-500">
                <i data-lucide="layers" class="w-16 h-16 text-indigo-600"></i>
            </div>
            <h3 class="text-slate-500 font-medium text-sm mb-1 uppercase tracking-wider">Total Balance</h3>
            <p class="text-3xl font-bold text-slate-900">
                <%= stats.balance %>
            </p>
        </div>

        <!-- Income Card -->
        <div class="glass p-6 rounded-3xl relative overflow-hidden group border-l-4 border-emerald-500">
            <div class="absolute top-0 right-0 p-4 opacity-10 group-hover:scale-110 transition-transform duration-500">
                <i data-lucide="trending-up" class="w-16 h-16 text-emerald-600"></i>
            </div>
            <h3 class="text-slate-500 font-medium text-sm mb-1 uppercase tracking-wider">Total Income</h3>
            <p class="text-3xl font-bold text-emerald-600">
                <%= stats.income %>
            </p>
        </div>

        <!-- Expense Card -->
        <div class="glass p-6 rounded-3xl relative overflow-hidden group border-l-4 border-rose-500">
            <div class="absolute top-0 right-0 p-4 opacity-10 group-hover:scale-110 transition-transform duration-500">
                <i data-lucide="trending-down" class="w-16 h-16 text-rose-600"></i>
            </div>
            <h3 class="text-slate-500 font-medium text-sm mb-1 uppercase tracking-wider">Total Expense</h3>
            <p class="text-3xl font-bold text-rose-600">
                <%= stats.expense %>
            </p>
        </div>
    </div>

    <!-- Filter & Search Bar -->
    <div class="glass p-4 rounded-2xl flex flex-col md:flex-row gap-4 items-center justify-between">
        <form action="/" method="GET" class="flex flex-col md:flex-row gap-4 w-full">
            <!-- Search Input -->
            <div class="relative flex-grow">
                <i data-lucide="search" class="absolute left-4 top-1/2 -translate-y-1/2 w-4 h-4 text-slate-400"></i>
                <input type="text" name="search" placeholder="Search transactions..."
                    value="<%= filters.search || '' %>"
                    class="w-full bg-slate-50/50 border-none ring-1 ring-slate-200 rounded-xl py-2.5 pl-11 pr-4 focus:ring-2 focus:ring-indigo-500 transition-all text-sm font-medium">
            </div>

            <!-- Category Filter -->
            <div class="flex gap-4">
                <select name="category" onchange="this.form.submit()"
                    class="bg-slate-50/50 border-none ring-1 ring-slate-200 rounded-xl py-2.5 px-4 focus:ring-2 focus:ring-indigo-500 transition-all text-sm font-medium min-w-[160px] appearance-none cursor-pointer">
                    <option value="">All Categories</option>
                    <% categories.forEach(cat=> { %>
                        <option value="<%= cat.id %>" <%=filters.category===cat.id ? 'selected' : '' %>>
                            <%= cat.name %>
                        </option>
                        <% }) %>
                </select>

                <a href="/"
                    class="flex items-center justify-center p-2.5 rounded-xl bg-slate-100 text-slate-500 hover:bg-slate-200 transition-colors"
                    title="Reset Filters">
                    <i data-lucide="rotate-cw" class="w-4 h-4 text-slate-500"></i>
                </a>
            </div>
        </form>
    </div>

    <!-- Recent Transactions -->
    <div class="glass rounded-3xl overflow-hidden">
        <div class="p-6 border-b border-slate-100 flex justify-between items-center bg-white/50">
            <h2 class="text-xl font-bold text-slate-800">Recent Transactions</h2>
            <button class="text-indigo-600 font-semibold text-sm hover:underline italic">view history</button>
        </div>
        <div class="overflow-x-auto">
            <table class="w-full text-left">
                <thead>
                    <tr class="text-slate-400 text-sm uppercase tracking-tighter">
                        <th class="px-6 py-4 font-medium">Transaction</th>
                        <th class="px-6 py-4 font-medium">Category</th>
                        <th class="px-6 py-4 font-medium">Date</th>
                        <th class="px-6 py-4 font-medium text-right">Amount</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-50">
                    <% transactions.forEach(item=> { %>
                        <tr class="group hover:bg-slate-50/50 transition-colors">
                            <td class="px-6 py-5">
                                <div class="flex items-center gap-3">
                                    <div class="w-11 h-11 rounded-2xl flex items-center justify-center transition-all duration-300 group-hover:scale-105"
                                        style="background-color: <%= item.categories?.color %>15; color: <%= item.categories?.color %>">
                                        <i data-lucide="<%= item.categories?.icon || 'box' %>" class="w-5 h-5"></i>
                                    </div>
                                    <div>
                                        <p class="font-bold text-slate-800 capitalize">
                                            <%= item.note || 'No description' %>
                                        </p>
                                        <p class="text-[10px] text-slate-400 uppercase tracking-[0.2em] font-black">
                                            <%= item.type %>
                                        </p>
                                    </div>
                                </div>
                            </td>
                            <td class="px-6 py-5">
                                <span class="px-3 py-1 rounded-full text-[11px] font-black uppercase tracking-wider"
                                    style="background-color: <%= item.categories?.color %>10; color: <%= item.categories?.color %>">
                                    <%= item.categories?.name || 'Uncategorized' %>
                                </span>
                            </td>
                            <td class="px-6 py-5 text-slate-500 text-sm font-medium">
                                <%= formatter.formatDate(item.date) %>
                            </td>
                            <td
                                class="px-6 py-5 text-right font-black <%= item.type === 'income' ? 'text-emerald-500' : 'text-slate-900 border-r-4 border-rose-500/0 group-hover:border-rose-500/100 transition-all' %>">
                                <span class="text-xs mr-1">
                                    <%= item.type==='expense' ? '-' : '+' %>
                                </span>
                                <%= formatter.formatCurrency(item.amount) %>
                            </td>
                        </tr>
                        <% }) %>
                </tbody>
            </table>
        </div>
    </div>
</div>