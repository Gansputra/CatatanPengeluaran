<div class="space-y-8">
    <!-- Chart Data (Hidden) -->
    <script id="chart-data" type="application/json">
        <%- JSON.stringify(chartData) %>
    </script>

    <!-- Stats Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- Balance Card -->
        <div class="glass p-6 rounded-3xl relative overflow-hidden group">
            <div class="absolute top-0 right-0 p-4 opacity-10 group-hover:scale-110 transition-transform duration-500">
                <i data-lucide="layers" class="w-16 h-16 text-indigo-600"></i>
            </div>
            <h3 class="text-slate-500 font-medium text-sm mb-1 uppercase tracking-wider">Total Balance</h3>
            <p class="text-3xl font-medium text-slate-900">
                <%= stats.balance %>
            </p>
        </div>

        <!-- Income Card -->
        <div class="glass p-6 rounded-3xl relative overflow-hidden group border-l-4 border-emerald-500">
            <div class="absolute top-0 right-0 p-4 opacity-10 group-hover:scale-110 transition-transform duration-500">
                <i data-lucide="trending-up" class="w-16 h-16 text-emerald-600"></i>
            </div>
            <h3 class="text-slate-500 font-medium text-sm mb-1 uppercase tracking-wider">Total Income</h3>
            <p class="text-3xl font-medium text-emerald-600">
                <%= stats.income %>
            </p>
        </div>

        <!-- Expense Card -->
        <div class="glass p-6 rounded-3xl relative overflow-hidden group border-l-4 border-rose-500">
            <div class="absolute top-0 right-0 p-4 opacity-10 group-hover:scale-110 transition-transform duration-500">
                <i data-lucide="trending-down" class="w-16 h-16 text-rose-600"></i>
            </div>
            <h3 class="text-slate-500 font-medium text-sm mb-1 uppercase tracking-wider">Total Expense</h3>
            <p class="text-3xl font-medium text-rose-600">
                <%= stats.expense %>
            </p>
        </div>
    </div>

    <!-- Charts Section -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <!-- Weekly Spending Chart -->
        <div class="lg:col-span-2 glass p-6 rounded-3xl">
            <div class="flex items-center justify-between mb-6">
                <h3 class="text-slate-800 font-medium flex items-center gap-2">
                    <i data-lucide="bar-chart-3" class="w-5 h-5 text-indigo-500"></i>
                    Weekly Spending
                </h3>
            </div>
            <div class="h-[250px] relative">
                <canvas id="weeklyChart"></canvas>
            </div>
        </div>

        <!-- Category Distribution -->
        <div class="glass p-6 rounded-3xl">
            <h3 class="text-slate-800 font-medium flex items-center gap-2 mb-6">
                <i data-lucide="pie-chart" class="w-5 h-5 text-violet-500"></i>
                Top Categories
            </h3>
            <div class="h-[250px] relative flex items-center justify-center">
                <canvas id="categoryChart"></canvas>
            </div>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            // Read data from JSON script tag
            const rawData = document.getElementById('chart-data').textContent;
            const chartData = JSON.parse(rawData);

            const weeklyLabels = JSON.parse(chartData.weeklyLabels);
            const weeklyValues = JSON.parse(chartData.weeklyValues);
            const categoryLabels = JSON.parse(chartData.categoryLabels);
            const categoryValues = JSON.parse(chartData.categoryValues);
            const categoryColors = JSON.parse(chartData.categoryColors);

            // Chart 1: Weekly Spending
            const weeklyCtx = document.getElementById('weeklyChart').getContext('2d');
            new Chart(weeklyCtx, {
                type: 'bar',
                data: {
                    labels: weeklyLabels,
                    datasets: [{
                        label: 'Spending',
                        data: weeklyValues,
                        backgroundColor: '#6366f1',
                        borderRadius: 8,
                        barThickness: 30,
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            backgroundColor: '#1e293b',
                            padding: 12,
                            borderRadius: 12,
                            titleFont: { size: 14, weight: 'bold' }
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            grid: { display: false },
                            ticks: { font: { size: 10 } }
                        },
                        x: {
                            grid: { display: false },
                            ticks: { font: { size: 10 } }
                        }
                    }
                }
            });

            // Chart 2: Top Categories
            const categoryCtx = document.getElementById('categoryChart').getContext('2d');
            new Chart(categoryCtx, {
                type: 'doughnut',
                data: {
                    labels: categoryLabels,
                    datasets: [{
                        data: categoryValues,
                        backgroundColor: categoryColors,
                        borderWidth: 0,
                        hoverOffset: 15
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    cutout: '75%',
                    plugins: {
                        legend: {
                            position: 'bottom',
                            labels: {
                                usePointStyle: true,
                                pointStyle: 'circle',
                                padding: 20,
                                font: { size: 11, weight: '500' }
                            }
                        }
                    }
                }
            });
        });
    </script>

    <!-- Filter & Search Bar -->
    <div class="glass p-4 rounded-2xl flex flex-col md:flex-row gap-4 items-center justify-between">
        <form action="/" method="GET" class="flex flex-col md:flex-row gap-4 w-full">
            <!-- Search Input -->
            <div class="relative flex-grow">
                <i data-lucide="search" class="absolute left-4 top-1/2 -translate-y-1/2 w-4 h-4 text-slate-400"></i>
                <input type="text" name="search" placeholder="Search transactions..."
                    value="<%= filters.search || '' %>"
                    class="w-full bg-slate-50/50 border-none ring-1 ring-slate-200 rounded-xl py-2.5 pl-11 pr-4 focus:ring-2 focus:ring-indigo-500 transition-all text-sm font-medium">
            </div>

            <!-- Category Filter -->
            <div class="flex gap-4">
                <div class="relative group" id="filterCategoryGroup">
                    <input type="hidden" name="category" id="filterCategoryId" value="<%= filters.category || '' %>">
                    <div id="filterCategoryTrigger"
                        class="bg-slate-50/50 border-none ring-1 ring-slate-200 rounded-xl py-2.5 pl-4 pr-10 focus-within:ring-2 focus-within:ring-indigo-500 transition-all text-sm font-medium min-w-[200px] cursor-pointer flex items-center justify-between">
                        <div class="flex items-center gap-2" id="filterSelectedDisplay">
                            <% const currentCat=categories.find(c=> c.id === filters.category); %>
                                <% if (currentCat) { %>
                                    <div class="w-6 h-6 rounded flex items-center justify-center text-white"
                                        style="background-color: <%= currentCat.color %>">
                                        <i data-lucide="<%= currentCat.icon %>" class="w-3.5 h-3.5"></i>
                                    </div>
                                    <span class="text-slate-700">
                                        <%= currentCat.name %>
                                    </span>
                                    <% } else { %>
                                        <i data-lucide="filter" class="w-4 h-4 text-slate-400"></i>
                                        <span class="text-slate-400">All Categories</span>
                                        <% } %>
                        </div>
                        <i data-lucide="chevron-down"
                            class="absolute right-4 top-1/2 -translate-y-1/2 w-4 h-4 text-slate-400 pointer-events-none transition-transform group-[.active]/trigger:-rotate-180"></i>
                    </div>

                    <!-- Dropdown Content -->
                    <div id="filterCategoryDropdown"
                        class="absolute top-full right-0 mt-2 bg-white rounded-2xl shadow-2xl border border-slate-100 p-1.5 z-[60] hidden min-w-[220px] animate-in slide-in-from-top-2 duration-200">
                        <div class="max-h-[280px] overflow-y-auto custom-scrollbar space-y-0.5">
                            <div class="filter-option flex items-center gap-3 p-2.5 rounded-xl hover:bg-slate-50 cursor-pointer transition-all"
                                data-id="">
                                <div
                                    class="w-8 h-8 rounded-lg bg-slate-100 flex items-center justify-center text-slate-400">
                                    <i data-lucide="layers" class="w-4 h-4"></i>
                                </div>
                                <span class="text-slate-600 font-medium">All Categories</span>
                            </div>
                            <% categories.forEach(cat=> { %>
                                <div class="filter-option flex items-center gap-3 p-2.5 rounded-xl hover:bg-slate-50 cursor-pointer transition-all"
                                    data-id="<%= cat.id %>" data-name="<%= cat.name %>" data-icon="<%= cat.icon %>"
                                    data-color="<%= cat.color %>">
                                    <div class="w-8 h-8 rounded-lg flex items-center justify-center text-white"
                                        style="background-color: <%= cat.color %>">
                                        <i data-lucide="<%= cat.icon %>" class="w-4 h-4"></i>
                                    </div>
                                    <span class="font-medium text-slate-700">
                                        <%= cat.name %>
                                    </span>
                                </div>
                                <% }) %>
                        </div>
                    </div>

                    <script>
                        document.addEventListener('DOMContentLoaded', () => {
                            const trigger = document.getElementById('filterCategoryTrigger');
                            const dropdown = document.getElementById('filterCategoryDropdown');
                            const hiddenInput = document.getElementById('filterCategoryId');
                            const options = document.querySelectorAll('.filter-option');
                            const form = trigger.closest('form');

                            trigger.addEventListener('click', () => {
                                dropdown.classList.toggle('hidden');
                                trigger.closest('.relative').classList.toggle('active');
                            });

                            options.forEach(option => {
                                option.addEventListener('click', () => {
                                    hiddenInput.value = option.dataset.id;
                                    form.submit();
                                });
                            });

                            document.addEventListener('click', (e) => {
                                if (!trigger.contains(e.target) && !dropdown.contains(e.target)) {
                                    dropdown.classList.add('hidden');
                                    trigger.closest('.relative').classList.remove('active');
                                }
                            });
                        });
                    </script>
                </div>

                <a href="/"
                    class="flex items-center justify-center p-2.5 rounded-xl bg-slate-100 text-slate-500 hover:bg-slate-200 transition-colors"
                    title="Reset Filters">
                    <i data-lucide="rotate-cw" class="w-4 h-4 text-slate-500"></i>
                </a>
            </div>
        </form>
    </div>

    <!-- Recent Transactions -->
    <div class="glass rounded-3xl overflow-hidden">
        <div class="p-6 border-b border-slate-100 flex justify-between items-center bg-white/50">
            <h2 class="text-xl font-medium text-slate-800">Recent Transactions</h2>
            <button class="text-indigo-600 font-medium text-sm hover:underline italic">view history</button>
        </div>
        <div class="overflow-x-auto">
            <table class="w-full text-left">
                <thead>
                    <tr class="text-slate-400 text-sm uppercase tracking-tighter">
                        <th class="px-6 py-4 font-medium">Transaction</th>
                        <th class="px-6 py-4 font-medium">Category</th>
                        <th class="px-6 py-4 font-medium">Date</th>
                        <th class="px-6 py-4 font-medium text-right">Amount</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-50">
                    <% transactions.forEach(item=> { %>
                        <tr class="group hover:bg-slate-50/50 transition-colors">
                            <td class="px-6 py-5">
                                <div class="flex items-center gap-3">
                                    <div class="w-11 h-11 rounded-2xl flex items-center justify-center transition-all duration-300 group-hover:scale-105"
                                        style="background-color: <%= item.categories?.color %>15; color: <%= item.categories?.color %>">
                                        <i data-lucide="<%= item.categories?.icon || 'box' %>" class="w-5 h-5"></i>
                                    </div>
                                    <div>
                                        <p class="font-medium text-slate-800 capitalize">
                                            <%= item.note || 'No description' %>
                                        </p>
                                        <p class="text-[10px] text-slate-400 uppercase tracking-[0.2em] font-medium">
                                            <%= item.type %>
                                        </p>
                                    </div>
                                </div>
                            </td>
                            <td class="px-6 py-5">
                                <span class="px-3 py-1 rounded-full text-[11px] font-medium uppercase tracking-wider"
                                    style="background-color: <%= item.categories?.color %>10; color: <%= item.categories?.color %>">
                                    <%= item.categories?.name || 'Uncategorized' %>
                                </span>
                            </td>
                            <td class="px-6 py-5 text-slate-500 text-sm font-medium">
                                <%= formatter.formatDate(item.date) %>
                            </td>
                            <td
                                class="px-6 py-5 text-right font-medium <%= item.type === 'income' ? 'text-emerald-500' : 'text-slate-900 border-r-4 border-rose-500/0 group-hover:border-rose-500/100 transition-all' %>">
                                <span class="text-xs mr-1">
                                    <%= item.type==='expense' ? '-' : '+' %>
                                </span>
                                <%= formatter.formatCurrency(item.amount) %>
                            </td>
                        </tr>
                        <% }) %>
                </tbody>
            </table>
        </div>
    </div>
</div>